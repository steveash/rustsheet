{
 "format": "rustsheet-export-case/v1",
 "description": "t4177-api-items.export.json with refreshOnLoad=\"1\" written onto the exported cache (a patch: the API cannot set it), so Excel rebuilds the cache and re-renders the pivot from the generated <items> on open.",
 "tags": [
  "pivot",
  "export",
  "T-4177",
  "M16"
 ],
 "spec": {
  "format": "rustsheet-case/v1",
  "sheets": [
   {
    "name": "Data",
    "cells": {
     "A1": "Item",
     "B1": "S",
     "A2": "East",
     "B2": 1,
     "A3": "West",
     "B3": 2,
     "B4": 4,
     "A5": true,
     "B5": 8,
     "A6": 43831,
     "B6": 16,
     "A7": 7,
     "B7": 32,
     "A8": "=NA()",
     "B8": 64,
     "A9": "East",
     "B9": 128,
     "A10": 2.5,
     "B10": 256
    },
    "number_formats": {
     "A6": "yyyy-mm-dd"
    }
   },
   {
    "name": "P",
    "cells": {}
   },
   {
    "name": "Calc",
    "cells": {
     "B1": "=GETPIVOTDATA(\"Sum of S\",P!$A$3,\"Item\",\"East\")",
     "B2": "=GETPIVOTDATA(\"Sum of S\",P!$A$3,\"Item\",\"West\")",
     "B3": "=GETPIVOTDATA(\"Sum of S\",P!$A$3,\"Item\",True)",
     "B4": "=GETPIVOTDATA(\"Sum of S\",P!$A$3,\"Item\",DATE(2020,1,1))",
     "B5": "=GETPIVOTDATA(\"Sum of S\",P!$A$3,\"Item\",7)",
     "B6": "=GETPIVOTDATA(\"Sum of S\",P!$A$3,\"Item\",2.5)",
     "B7": "=GETPIVOTDATA(\"Sum of S\",P!$A$3)"
    }
   }
  ]
 },
 "pivots": [
  {
   "name": "Items",
   "source": "Data!A1:B10",
   "location": "P!A3",
   "row": "Item",
   "value": "S"
  }
 ],
 "patches": [
  {
   "part": "xl/pivotCache/pivotCacheDefinition*.xml",
   "find": "<pivotCacheDefinition xmlns=",
   "replace": "<pivotCacheDefinition refreshOnLoad=\"1\" xmlns="
  }
 ]
}

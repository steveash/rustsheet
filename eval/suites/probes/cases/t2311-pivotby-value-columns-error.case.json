 "sheets": [
  {
   "name": "P",
   "cells": {
    "A1": "2v err some cells",
    "B1": "=LET(r,_xlfn.PIVOTBY(D!A1:A5,D!B1:B5,D!C1:D5,LAMBDA(v,IF(SUM(v)=2,NA(),SUM(v)))),IFERROR(ROWS(r)&\"x\"&COLUMNS(r),\"E\"&ERROR.TYPE(r)))",
    "C1": "=IFERROR(SUM(--ISERROR(_xlfn.PIVOTBY(D!A1:A5,D!B1:B5,D!C1:D5,LAMBDA(v,IF(SUM(v)=2,NA(),SUM(v)))))),\"E\")",
    "D1": "=IFERROR(TEXTJOIN(\"|\",FALSE,MAP(_xlfn.PIVOTBY(D!A1:A5,D!B1:B5,D!C1:D5,LAMBDA(v,IF(SUM(v)=2,NA(),SUM(v)))),LAMBDA(x,IFERROR(x&\"\",\"#\"&ERROR.TYPE(x))))),\"E\")",
    "A2": "2v err via data",
    "B2": "=LET(r,_xlfn.PIVOTBY(D!A1:A5,D!B1:B5,D!D1:E5,_xleta.SUM),IFERROR(ROWS(r)&\"x\"&COLUMNS(r),\"E\"&ERROR.TYPE(r)))",
    "C2": "=IFERROR(SUM(--ISERROR(_xlfn.PIVOTBY(D!A1:A5,D!B1:B5,D!D1:E5,_xleta.SUM))),\"E\")",

  "description": "Adding a sheet whose name an INDIRECT text names makes it resolve. (T-1608)",
  "tags": [
    "M8",
    "sheet-ops",
    "references",
    "probe"
  ],
  "sheets": [
    {
      "name": "Calc",
      "cells": {
        "A1": "=INDIRECT(\"New!A1\")",

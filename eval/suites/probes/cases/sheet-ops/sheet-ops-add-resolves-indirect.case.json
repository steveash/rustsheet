        "A3": "=IFERROR(INDIRECT(\"Other!A1\"),\"none\")"
      }
    },
    {
      "name": "Data",
      "cells": {
        "A1": 1,
        "A2": 2,
        "A3": "x"
      }
    }
  ],
  "sheet_ops": [
    {
      "op": "add",
      "sheet": "New"
    }
  ]

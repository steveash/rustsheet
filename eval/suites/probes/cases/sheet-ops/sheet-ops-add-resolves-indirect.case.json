{
  "format": "rustsheet-case/v1",
  "description": "Adding a sheet whose name an INDIRECT text names makes it resolve. The cell naming a sheet that never exists is not scored (known web/desktop divergence, lookup.md). (T-1608)",
  "tags": [
    "M8",
    "sheet-ops",
    "references",
    "probe"
  ],
  "sheets": [
    {
      "name": "Calc",
      "cells": {
        "A1": "=INDIRECT(\"New!A1\")",
        "A2": "=ISREF(INDIRECT(\"New!A1\"))",
        "A3": "=IFERROR(INDIRECT(\"Other!A1\"),\"none\")"
      }
    },
    {
      "name": "Data",
      "cells": {
        "A1": 1,
        "A2": 2,
        "A3": "x"
      }
    }
  ],
  "sheet_ops": [
    {
      "op": "add",
      "sheet": "New"
    }
  ],
  "check": [
    "Calc!A1",
    "Calc!A2"
  ]
}
